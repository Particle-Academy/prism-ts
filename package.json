{
  "name": "@particle-academy/prism",
  "version": "0.9.1",
  "description": "TypeScript port of Prism — a unified API layer over LLM providers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/prism-ts.git"
  },
  "type": "module",
  "private": false,
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "conformance": "npm run build && node conformance/runner.mjs",
    "agent": "node agent/server.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "//": "G190: Remove the minimatch override when ESLint accepts minimatch 11 or newer, then verify the lint file census and diagnostics again.",
  "overrides": {
    "minimatch": "11.0.5"
  }
}
